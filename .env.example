# Required: paste your OpenRouter API key here
OPENROUTER_API_KEY=

# Optional: override the default model used by app/api/generate/route.ts
# Examples: anthropic/claude-3.5-haiku, openai/gpt-4o-mini, google/gemini-2.0-flash-001
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Optional: used as the HTTP-Referer header for OpenRouter rankings/analytics
NEXT_PUBLIC_SITE_URL=http://localhost:3000
