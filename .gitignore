# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js / production output
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# test output and coverage
/coverage
/playwright-report/
/test-results/

# env files, keep only the safe template
.env*
!.env.example

# deployment / local tool state
.vercel
.mcp.json

# logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local OS/editor files
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# AI agent/tooling state and prompts
.agents/
agents/
.claude-flow/
.claude/
CLAUDE.md
AGENTS.md

# generated design/code-analysis artifacts
/design-images/
/design/
/graphify-out/
DESIGN.md

# local ad-hoc scripts that may contain secrets
/test-llm.js
